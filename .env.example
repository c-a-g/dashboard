# Copy to `.env` and fill in. Gitignored, so it stays on your machine.
#
# Read by load_dotenv() in main.py: a real environment variable wins over this
# file, and `--api-key` wins over both. Quotes are optional and get stripped.

# Key for the upstream API.
API_KEY=

# The search endpoint, and the one that serves a single notice's full text.
# Both are required; nothing is assumed if they are missing.
API_BASE=https://api.sam.gov/opportunities/v2/search
API_DESC_URL=https://api.sam.gov/prod/opportunities/v1/noticedesc

# Where a dashboard row links to. {id} is replaced with the notice id.
# Leave blank and titles render as plain text.
NOTICE_URL=https://sam.gov/workspace/contract/opp/{id}/view
