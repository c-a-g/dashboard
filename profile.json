{
  "_comment": [
    "Scoring profile: data analytics & BI, custom software, AI/ML. Small business.",
    "Edit and re-run `python main.py score`.",
    "Every number appears in a notice's score breakdown, so a wrong-looking",
    "result traces back to the rule that produced it.",
    "NAICS is weak on purpose: only 5% of tech-keyword titles carry 541511."
  ],
  "psc": {
    "_comment": "Product Service Code. Tracks what is being bought better than NAICS.",
    "strong": {
      "points": 32,
      "codes": [
        "DA01",
        "DA10",
        "DB01",
        "DB10",
        "DD01",
        "DF01",
        "DC01",
        "DC10"
      ],
      "_meaning": "D-series: IT services. Work someone performs."
    },
    "moderate": {
      "points": 18,
      "codes": [
        "7A20",
        "7A21",
        "7H20",
        "7J20",
        "DE01",
        "DH10"
      ],
      "_meaning": "Software products. A product buy is a reseller's job."
    },
    "weak": {
      "points": 7,
      "codes": [
        "R425",
        "R499",
        "R408",
        "R707"
      ],
      "_meaning": "Professional/technical support. Mixed; keywords decide."
